# Paddle sandbox first, then switch to live values when you're ready to launch.

# Paddle > Developer Tools > Authentication > API key (server-side secret)
PADDLE_API_KEY=

# Paddle > Developer Tools > Notifications > (your destination) > Secret key
PADDLE_WEBHOOK_SECRET=

# "sandbox" while testing, "production" when you go live
PADDLE_ENV=sandbox

# Paddle > Catalog > Prices > (your $1.99/mo price) > Price ID, starts with pri_
PADDLE_PRICE_ID=
